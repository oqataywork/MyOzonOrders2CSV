{
  "manifest_version": 3,
  "name": "OzonMyOrders2csv",
  "version": "0.9.0",
  "version_name": "0.9.0",
  "minimum_chrome_version": "116",
  "description": "Экспортирует историю заказов из личного кабинета покупателя Ozon в CSV.",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://ozon.ru/*",
    "https://www.ozon.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Заказы Ozon — выгрузить в CSV"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ozon.ru/*",
        "https://www.ozon.ru/*"
      ],
      "js": [
        "security.js",
        "return-tools.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
